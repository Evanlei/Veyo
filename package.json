{
  "name": "veyo",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "test": "npm run test --workspace frontend",
    "typecheck": "npm run typecheck --workspace frontend",
    "api": "cd backend && .venv/bin/python -m uvicorn veyo.app:app --host 127.0.0.1 --port 8000",
    "start": "npm run build && npm run api",
    "cloud": "bash scripts/google-cloud.sh"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
