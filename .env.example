# Optional API environment settings. Local defaults require no configuration.
# Set these in the process environment; never commit secrets.
VEYO_STORAGE_DIR=./storage
VEYO_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
VEYO_THREADS=4
# Defaults to the repository's frontend/dist after npm run build:
# VEYO_FRONTEND_DIR=/absolute/path/to/frontend/dist
# Set by the cloud deployment script:
VEYO_GCS_BUCKET=
